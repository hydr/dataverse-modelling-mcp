{
  "mcpServers": {
    "dataverse-modelling": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-server.ps1",
        "-PluginRoot",
        "${CLAUDE_PLUGIN_ROOT}",
        "-PluginData",
        "${CLAUDE_PLUGIN_DATA}"
      ],
      "env": {
        "DATAVERSE_URL": "${user_config.dataverse_url}",
        "AZURE_CLIENT_ID": "${user_config.client_id}",
        "AZURE_TENANT_ID": "${user_config.tenant_id}"
      }
    }
  }
}
