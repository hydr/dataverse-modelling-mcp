# Shell scripts and the version marker must stay LF, otherwise the SessionStart
# hook breaks in git-bash/Unix ("bad interpreter: ...^M").
*.sh            text eol=lf
scripts/BINARY_VERSION text eol=lf

# PowerShell tolerates both, keep it stable.
*.ps1           text

# The cross-platform launcher pair: `launch` is a POSIX shell script (LF, executable),
# `launch.cmd` its Windows twin (CRLF, as cmd.exe expects).
scripts/launch      text eol=lf
*.cmd               text eol=crlf
